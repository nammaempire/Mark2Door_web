rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product photos: anyone can view, only admins can upload or delete.
    match /products/{file} {
      allow read: if true;
      allow write: if request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
          && (request.resource == null
              || (request.resource.size < 2 * 1024 * 1024
                  && request.resource.contentType.matches('image/.*')));
    }
    // Proof-of-delivery photos: taken by a delivery partner (signed in by
    // phone) and viewed by the store. Images only, up to 5 MB.
    match /deliveries/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && 'phone_number' in request.auth.token
          && request.resource != null
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }
  }
}
